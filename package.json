{
  "name": "openres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted reservations and a tablet-friendly restaurant floor desk.",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 4020",
    "demo": "OPENRES_DEMO=1 next dev --hostname 127.0.0.1 -p 4020",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start -p 4020",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "staff:create": "node scripts/create-staff.mjs",
    "test:audit": "NEXT_BUILD_DIR=.next-audit npm run build && node scripts/audit/index.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.473.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.3",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
