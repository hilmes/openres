# Demo mode needs no environment file: npm run demo
# Never point tests at a real guest database.
DATABASE_URL=postgres://openres:replace-this-password@127.0.0.1:5432/openres
OPENRES_BASE_URL=http://localhost:4020
# Generate a unique random value, at least 32 characters. Keep stable for private booking links.
OPENRES_TOKEN_SECRET=
# Run npm run staff:create, then place its JSON object(s) in this array.
OPENRES_STAFF_USERS=[]
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
OPENRES_TRUST_PROXY=0
# Optional confirmation delivery; use your own verified sender.
RESEND_API_KEY=
OPENRES_EMAIL_FROM=
